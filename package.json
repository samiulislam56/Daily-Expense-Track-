{
  "name": "dailyflow-workspace",
  "version": "1.0.0",
  "description": "DailyFlow — Personal Daily Expense Management Software",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "node start-dev.mjs",
    "start": "node start-dev.mjs",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test": "npm run test:backend && npm run test:frontend",
    "migrate": "npm --prefix backend run migrate",
    "seed": "npm --prefix backend run seed"
  },
  "keywords": [
    "expense-tracker",
    "personal-finance",
    "react19",
    "postgresql",
    "typescript"
  ],
  "author": "DailyFlow Contributors",
  "license": "MIT"
}
