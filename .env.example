# DailyFlow Environment Variables

# Backend Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# PostgreSQL connection string for production or local PostgreSQL server
# e.g., postgresql://postgres:postgres@localhost:5432/dailyflow
# If unset or prefixed with memory:// or local://, DailyFlow automatically uses embedded PostgreSQL (PGlite)
DATABASE_URL=memory://dailyflow

# Logging
LOG_LEVEL=info

# Frontend Build Time
# VITE_API_BASE_URL=http://localhost:4000
